{
  "name": "game-capesorrow",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "typecheck": "tsc -p client --noEmit",
    "lint": "eslint .",
    "test": "vitest run --root client && vitest run --root tools",
    "test:client": "vitest run --root client",
    "test:tools": "vitest run --root tools",
    "gate": "node node_modules/@csarkosh/engine/tools/gate.mjs",
    "deploy:client": "node tools/deploy/client.mjs",
    "deploy:verify": "node tools/deploy/verify.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
